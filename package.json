{
  "name": "building-management",
  "private": true,
  "scripts": {
    "knowledge:index": "python3 scripts/knowledge/cli.py index",
    "knowledge:status": "python3 scripts/knowledge/cli.py status",
    "knowledge:query": "python3 scripts/knowledge/cli.py query",
    "knowledge:context": "python3 scripts/knowledge/cli.py context",
    "knowledge:eval": "python3 scripts/knowledge/cli.py eval",
    "knowledge:eval:lexical": "python3 scripts/knowledge/cli.py eval --lexical",
    "knowledge:benchmark": "python3 scripts/knowledge/cli.py eval --cases knowledge/evaluation/requests.json",
    "knowledge:validate-eval": "python3 scripts/knowledge/cli.py validate-eval",
    "knowledge:eval-understanding": "python3 scripts/knowledge/cli.py eval-understanding",
    "knowledge:test": "python3 -m unittest discover -s scripts/knowledge -p 'test_*.py' -v",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "pnpm --filter api migrate",
    "db:seed": "pnpm --filter api seed",
    "dev": "pnpm db:up && concurrently -n web,api -c blue,green \"pnpm --filter web dev\" \"pnpm --filter api dev\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test:project-activation": "playwright test --config=e2e/playwright.activation.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.23"
  }
}
