# Isolated test/staging environment (R.0.03).
# Copy to .env.test-env (gitignored) or pass --env-file .env.test-env.example.

# Web
VITE_API_BASE_URL=http://localhost:8001/api

# API
SECRET_KEY=test-env-secret-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,api-test
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL — host port 5434 (dev uses 5433)
DATABASE_URL=postgres://ipcas:ipcas@localhost:5434/ipcas_test_env
POSTGRES_USER=ipcas
POSTGRES_PASSWORD=ipcas
POSTGRES_DB=ipcas_test_env

# Redis — host port 6380 (dev uses 6379)
# Django CACHES uses CELERY_BROKER_URL as LOCATION; REDIS_URL is documented for ops clarity.
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0
CELERY_TASK_ALWAYS_EAGER=true

# RabbitMQ — AMQP 5673 / management 15673 (dev uses 5672 / 15672)
RABBITMQ_URL=amqp://ipcas:ipcas@localhost:5673/
RABBITMQ_DEFAULT_USER=ipcas
RABBITMQ_DEFAULT_PASS=ipcas
AUDIT_LOG_ASYNC=false

# MinIO / S3 — API 9001 / console 9002 (dev uses 9000 / 9001)
AWS_S3_ENDPOINT_URL=http://localhost:9001
AWS_ACCESS_KEY_ID=ipcas
AWS_SECRET_ACCESS_KEY=ipcas-secret
AWS_STORAGE_BUCKET_NAME=ipcas-test-files
AWS_S3_REGION_NAME=us-east-1
AWS_S3_USE_SSL=false

# Seed role accounts on api-test container start
SEED_TEST_ROLES=true
