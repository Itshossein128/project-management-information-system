# Local acceptance only. Copy to .env.acceptance, which is gitignored. No production secrets.
DEBUG=true
RABBITMQ_URL=
MPP_MPXJ_JAR_DIR=/usr/local/lib/python3.12/site-packages/mpxj/lib
SECRET_KEY=a7p5-local-acceptance-only
DATABASE_URL=postgres://a7p5:a7p5@postgres:5432/a7p5_import
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false
AUDIT_LOG_ASYNC=false
IMPORT_CONTAINMENT_REQUIRED=true
IMPORT_PREPARE_INLINE=false
IMPORT_ADMISSION_REQUIRES_CATCHUP=true
IMPORT_EXECUTION_QUEUE=a7p5-import
IMPORT_MAINTENANCE_QUEUE=a7p5-maintenance
IMPORT_SCRATCH_ROOT=/var/a7p5-scratch
IMPORT_CGROUP_ROOT=/var/a7p5-cgroup
A7_P5_ISOLATED=1
ALLOWED_HOSTS=localhost,127.0.0.1,api,testserver

# Dedicated host resources created by prepare-host.sh; never mount the whole cgroup tree.
A7P5_CGROUP_HOST_ROOT=/sys/fs/cgroup/system.slice/a7p5-containment.service
A7P5_SCRATCH_HOST_ROOT=/run/a7p5-scratch
IMPORT_RUNTIME_HOST_ID=a7p5-local-delegation
A7_P5_FAULT_DIR=/var/a7p5-scratch/faults
CORS_ALLOWED_ORIGINS=http://127.0.0.1:15173,http://localhost:15173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:15173,http://localhost:15173
