# Persian translations for Velora API authentication messages.
msgid ""
msgstr ""
"Project-Id-Version: Velora API\n"
"Language: fa\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Invalid credentials. Please check your phone number and password."
msgstr "نام کاربری یا رمز عبور اشتباه است. لطفاً شماره موبایل و رمز عبور را بررسی کنید."

msgid "User account is disabled."
msgstr "حساب کاربری غیرفعال است."

msgid "Refresh token is required."
msgstr "توکن بازنشانی الزامی است."

msgid "Invalid refresh token."
msgstr "توکن بازنشانی نامعتبر است."

msgid "Logged out successfully."
msgstr "خروج با موفقیت انجام شد."

msgid "You can only list your own assignments unless you are HR or admin."
msgstr "فقط می‌توانید تخصیص‌های خود را مشاهده کنید مگر اینکه منابع انسانی یا مدیر باشید."

msgid "Password fields do not match."
msgstr "فیلدهای رمز عبور یکسان نیستند."

msgid "Username already exists."
msgstr "نام کاربری قبلاً ثبت شده است."

msgid "Mobile number is already registered."
msgstr "شماره موبایل قبلاً ثبت شده است."

msgid "Phone number or username is required."
msgstr "شماره موبایل یا نام کاربری الزامی است."

msgid "New password fields do not match."
msgstr "فیلدهای رمز عبور جدید یکسان نیستند."

msgid "If an account exists with this phone number, a reset code has been sent."
msgstr "اگر حسابی با این شماره وجود داشته باشد، کد بازنشانی ارسال شده است."

msgid "Password reset code sent successfully."
msgstr "کد بازنشانی رمز عبور با موفقیت ارسال شد."

msgid "Invalid or expired reset token."
msgstr "توکن بازنشانی نامعتبر یا منقضی شده است."

msgid "Password reset successfully."
msgstr "رمز عبور با موفقیت بازنشانی شد."

msgid "Current password is incorrect."
msgstr "رمز عبور فعلی اشتباه است."

msgid "New password must be different from the current password."
msgstr "رمز عبور جدید باید با رمز فعلی متفاوت باشد."

msgid "Password changed successfully."
msgstr "رمز عبور با موفقیت تغییر کرد."

msgid "Phone number must be 9-15 digits, optionally starting with +."
msgstr "شماره تلفن باید ۹ تا ۱۵ رقم باشد و می‌تواند با + شروع شود."

msgid "Validation error."
msgstr "خطای اعتبارسنجی."

msgid "Conflict."
msgstr "تعارض."

msgid "Project code is required."
msgstr "کد پروژه الزامی است."

msgid "You are not an active member of this project."
msgstr "شما عضو فعال این پروژه نیستید."

msgid "Too many requests. Please try again later."
msgstr "تعداد درخواست‌ها بیش از حد مجاز است. لطفاً بعداً دوباره تلاش کنید."

msgid "File size must not exceed 50 MB."
msgstr "حجم فایل نباید از ۵۰ مگابایت تجاوز کند."

msgid "File type is not allowed."
msgstr "نوع فایل مجاز نیست."

msgid "This field is required."
msgstr "این فیلد الزامی است."

msgid "Role name is required."
msgstr "نام نقش الزامی است."

msgid "Role name may only contain letters, numbers, spaces, hyphens, and underscores."
msgstr "نام نقش فقط می‌تواند شامل حروف، اعداد، فاصله، خط تیره و زیرخط باشد."

msgid "A role with this name already exists."
msgstr "نقشی با این نام از قبل وجود دارد."

msgid "Admin"
msgstr "مدیر سیستم"

msgid "HR"
msgstr "منابع انسانی"

msgid "Manager"
msgstr "مدیر"

msgid "Visitor"
msgstr "بازدیدکننده"

msgid "Engineer"
msgstr "مهندس"

msgid "Accountant"
msgstr "حسابدار"

msgid "Business setup"
msgstr "راه‌اندازی کسب‌وکار"

msgid "Ensure this field has no more than 255 characters."
msgstr "این فیلد نباید بیش از ۲۵۵ نویسه باشد."

msgid "Ensure this field has no more than 64 characters."
msgstr "این فیلد نباید بیش از ۶۴ نویسه باشد."

msgid "Ensure this field has no more than 500 characters."
msgstr "این فیلد نباید بیش از ۵۰۰ نویسه باشد."

msgid "Enter a valid number."
msgstr "یک عدد معتبر وارد کنید."

msgid "Quantity must be greater than or equal to zero."
msgstr "مقدار باید بزرگ‌تر یا مساوی صفر باشد."

msgid "At least one of quantity_in or quantity_out must be greater than zero."
msgstr "حداقل یکی از مقادیر ورودی یا خروجی باید بزرگ‌تر از صفر باشد."

msgid "Name cannot be empty."
msgstr "نام نمی‌تواند خالی باشد."

msgid "Name must be unique within the list."
msgstr "نام باید در فهرست یکتا باشد."

msgid "Cell cannot be empty."
msgstr "خانه نمی‌تواند خالی باشد."

msgid "Type must be benefit or cost."
msgstr "نوع باید سود یا هزینه باشد."

msgid "Weight cannot be empty."
msgstr "وزن نمی‌تواند خالی باشد."

msgid "Weight must be a finite number."
msgstr "وزن باید عدد متناهی باشد."

msgid "Weight must be finite."
msgstr "وزن باید متناهی باشد."

msgid "Weight cannot be negative."
msgstr "وزن نمی‌تواند منفی باشد."

msgid "Weight sum must be positive."
msgstr "مجموع وزن‌ها باید مثبت باشد."

msgid "Cost criterion cell cannot be zero."
msgstr "مقدار معیار هزینه نمی‌تواند صفر باشد."

msgid "Cell must be numeric."
msgstr "خانه باید عددی باشد."

msgid "Cell must be finite."
msgstr "خانه باید متناهی باشد."

msgid "Cell cannot be negative."
msgstr "خانه نمی‌تواند منفی باشد."

msgid "Method is not selected on this case."
msgstr "این روش روی پرونده انتخاب نشده است."

msgid "Decision runs are immutable."
msgstr "سابقه‌های اجرا تغییرناپذیرند."

msgid "Title cannot be empty."
msgstr "عنوان نمی‌تواند خالی باشد."

msgid "Title max length is 200."
msgstr "حداکثر طول عنوان ۲۰۰ نویسه است."

msgid "Criterion must be a string."
msgstr "معیار باید رشته باشد."

msgid "Cell must be strictly positive."
msgstr "مقدار خانه باید بزرگ‌تر از صفر باشد."

msgid "Diagonal element must be 1.0."
msgstr "مقدار قطر اصلی باید دقیقاً ۱ باشد."

msgid "Pairwise cells must be reciprocals (a[k,j] = 1 / a[j,k])."
msgstr "خانه‌های مقابل باید معکوس یکدیگر باشند."

msgid "AHP calculation must be finite."
msgstr "نتیجه محاسبه AHP باید متناهی باشد."

msgid "ahp_matrix must have %(n)s rows to match criteria."
msgstr "ماتریس AHP باید %(n)s سطر مطابق معیارها داشته باشد."

msgid "Row must have exactly %(n)s cells."
msgstr "سطر باید دقیقاً %(n)s خانه داشته باشد."

msgid "%(field)s must be a list of names."
msgstr "%(field)s باید فهرستی از نام‌ها باشد."

msgid "%(field)s must have at most %(maximum)s names."
msgstr "%(field)s باید حداکثر %(maximum)s نام داشته باشد."

msgid "%(field)s must have at least 1 name."
msgstr "%(field)s باید حداقل یک نام داشته باشد."

msgid "criteria"
msgstr "معیارها"

msgid "alternatives"
msgstr "گزینه‌ها"

msgid "n must be <= %(maximum)s."
msgstr "تعداد معیارها باید حداکثر %(maximum)s باشد."

msgid "n must be >= 1 for AHP."
msgstr "برای AHP باید حداقل یک معیار تعریف شود."

msgid "ahp_matrix must be a list of rows."
msgstr "ماتریس AHP باید فهرستی از سطرها باشد."

msgid "Row must be a list."
msgstr "سطر باید فهرست باشد."

msgid "Unknown method id: %(method)s."
msgstr "شناسه روش ناشناخته است: %(method)s."

msgid "Unknown decision method."
msgstr "روش تصمیم‌گیری ناشناخته است."

msgid "Must be a list of method ids."
msgstr "روش‌ها باید فهرستی از شناسه‌ها باشند."

msgid "AHP matrix must have %(n)s rows and %(n)s cells per row."
msgstr "ماتریس AHP باید %(n)s سطر و در هر سطر %(n)s خانه داشته باشد."

msgid "Relation must be exactly zero or one."
msgstr "رابطه باید دقیقاً صفر یا یک باشد."

msgid "Structural analysis could not be completed."
msgstr "تحلیل ساختاری تکمیل نشد."

msgid "Matrix must be a list of rows."
msgstr "ماتریس باید فهرستی از سطرها باشد."

msgid "Matrix dimensions must match criteria."
msgstr "ابعاد ماتریس باید با معیارها مطابقت داشته باشد."

msgid "Row dimensions must match criteria."
msgstr "ابعاد سطر باید با معیارها مطابقت داشته باشد."
